---
import Base from '../layouts/Base.astro';
import Sheet from '../components/Sheet.astro';
import Schedule from '../components/Schedule.astro';
import CrossRef from '../components/CrossRef.astro';
import {
  person,
  roles,
  coursework,
  activities,
  athletics,
  interests,
  skills,
} from '../data/profile';

// Résumé order is chronological within track, engineering first — the same
// ordering the homepage uses, from the same source.
const ordered = [
  ...roles.filter((r) => r.track === 'engineering'),
  ...roles.filter((r) => r.track === 'markets'),
];
---

<Base
  title={`Résumé — ${person.name}`}
  description={`${person.name} — MIT Computer Science (AI), expected May 2027. Full résumé: engineering and markets experience, education, and coursework.`}
>
  <main id="main">
    <Sheet index="R-1" caption="Résumé — S. Chen">
      <header class="head">
        <div class="head-nav">
          <CrossRef to="/" index="A-1" label="Working papers" back />
        </div>
        <div class="head-row">
          <div>
            <h1 class="head-name">{person.name}</h1>
            <p class="head-sub">
              {person.degree} · {person.minor} · {person.graduation}
            </p>
          </div>
          <a class="download" href={person.resumePdf}>
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor"
                 stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 1.5v8" /><path d="M3.8 6.4 7 9.6l3.2-3.2" /><path d="M2 12h10" />
            </svg>
            <span>Download PDF</span>
          </a>
        </div>
        <ul class="contact">
          <li><a href={`mailto:${person.email}`}>{person.email}</a></li>
          <li><a class="num" href={`tel:${person.phoneHref}`}>{person.phone}</a></li>
          <li><a href={person.github} target="_blank" rel="noopener noreferrer">{person.githubLabel}</a></li>
          <li><a href={person.linkedin} target="_blank" rel="noopener noreferrer">{person.linkedinLabel}</a></li>
          <li>{person.homeBase}</li>
        </ul>
      </header>

      <Schedule title="Education">
        <article class="row entry">
          <div class="when"><span class="num">2023 — 2027</span><span class="where">{person.termBase}</span></div>
          <div>
            <h3 class="org">{person.school}</h3>
            <p class="title">{person.degree}; {person.minor}</p>
            <ul class="points">
              <li><strong>GPA:</strong> {person.gpa}</li>
              <li><strong>Coursework:</strong> {coursework.join(', ')}</li>
              <li><strong>Activities:</strong> {activities.join(', ')}</li>
            </ul>
          </div>
        </article>
      </Schedule>

      <Schedule title="Experience">
        {ordered.map((r) => (
          <article class="row entry">
            <div class="when">
              <span class="num">{r.start} — {r.end}</span>
              <span class="where">{r.location}</span>
            </div>
            <div>
              <h3 class="org">{r.org}</h3>
              <p class="title">{r.title}</p>
              <ul class="points">
                {r.points.map((pt) => <li>{pt}</li>)}
              </ul>
            </div>
          </article>
        ))}
      </Schedule>

      <Schedule title="Leadership and athletics">
        <article class="row entry">
          <div class="when">
            <span class="num">{athletics.start} — {athletics.end}</span>
            <span class="where">{person.termBase}</span>
          </div>
          <div>
            <h3 class="org">{athletics.program}</h3>
            <p class="title">{athletics.title}</p>
            <ul class="points">
              {athletics.points.map((pt) => <li>{pt}</li>)}
            </ul>
          </div>
        </article>
      </Schedule>

      <Schedule title="Skills and interests">
        <article class="row entry">
          <div class="when"><span class="num">Current</span></div>
          <div>
            <ul class="points">
              <li><strong>Languages:</strong> {skills.languages.join(', ')}</li>
              <li><strong>Tools:</strong> {skills.tools.join(', ')}</li>
              <li><strong>Interests:</strong> {interests.join(', ')}</li>
            </ul>
          </div>
        </article>
      </Schedule>

      <hr class="rule-close" />

      <footer class="foot">
        <p class="foot-note">
          The projects behind this résumé are written up as working papers.
        </p>
        <CrossRef to="/#work" index="A-1" label="Schedule A" />
      </footer>
    </Sheet>
  </main>
</Base>

<style>
  .head { padding: var(--s-6) var(--s-5) var(--s-5); }
  .head-nav { margin-bottom: var(--s-5); }
  .head-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--s-5);
    flex-wrap: wrap;
  }
  .head-name { font-size: var(--t-2xl); letter-spacing: -0.04em; font-weight: 800; }
  .head-sub { margin-top: var(--s-2); color: var(--ink-muted); font-size: var(--t-md); }

  .download {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    flex: none;
    font-family: var(--f-data);
    font-size: var(--t-sm);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--red);
    text-decoration: none;
    border: 1px solid var(--red);
    padding: var(--s-2) var(--s-4);
    transition: background-color 0.18s var(--ease);
  }
  .download:hover, .download:focus-visible { background: var(--red-wash); }

  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin-top: var(--s-5);
    padding-top: var(--s-4);
    border-top: 1px solid var(--rule);
    font-size: var(--t-sm);
    color: var(--ink-muted);
  }
  .contact a { color: var(--ink-muted); text-underline-offset: 3px; }
  .contact a:hover { color: var(--red); }

  .entry { grid-template-columns: 11rem minmax(0, 1fr); align-items: start; }
  .when { display: grid; gap: var(--s-1); padding-top: 0.3rem; }
  .when .num { font-size: var(--t-sm); font-weight: 500; }
  .where { font-size: var(--t-xs); color: var(--ink-faint); }

  .org { font-size: var(--t-md); letter-spacing: -0.02em; }
  .title { font-size: var(--t-sm); color: var(--ink-muted); margin-top: 2px; }

  .points {
    margin-top: var(--s-3);
    display: grid;
    gap: var(--s-2);
    font-size: var(--t-sm);
    max-width: 72ch;
  }
  .points li {
    position: relative;
    padding-left: var(--s-4);
    font-size: var(--t-sm);
    line-height: 1.6;
    color: var(--ink-muted);
  }
  .points li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 6px;
    height: 1px;
    background: var(--rule-strong);
  }
  .points strong { color: var(--ink); font-weight: 600; }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    flex-wrap: wrap;
    padding: var(--s-5);
    background: var(--stock-band);
  }
  .foot-note { color: var(--ink-muted); font-size: var(--t-sm); }

  @media (max-width: 720px) {
    .head, .foot { padding-inline: var(--s-4); }
    .entry { grid-template-columns: 1fr; gap: var(--s-3); }
    .when { display: flex; gap: var(--s-3); align-items: baseline; padding-top: 0; }
  }
</style>
