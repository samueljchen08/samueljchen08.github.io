---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Carousel from '../components/Carousel.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ExperienceCard from '../components/ExperienceCard.astro';
import Tags from '../components/Tags.astro';
import { person, education, roles, activities, interests } from '../data/profile';
import { technicalSkills } from '../data/skills';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const technical = await technicalSkills();

const description =
  "Samuel Chen — MIT Computer Science (AI) '27. Projects in agentic RL environments, causal experiments on AI buyer agents, and sports tracking; experience at Nexus AI, Goldman Sachs, Barings, and Cercano.";

const gradYear = education.expected.match(/\d{4}/)?.[0]?.slice(-2);
const locations = person.locations.join(' / ');
---

<Base title="Samuel Chen" description={description}>
  <main id="main">
    <section class="hero">
      <div class="container hero-inner">
        {/* Decorative: the name it belongs to is the very next thing announced. */}
        <img class="portrait" src="/headshot.webp" alt="" width="150" height="150" />
        <div class="hero-text">
        <h1>{person.name}</h1>
        <p class="meta mono">MIT CS-AI '{gradYear} · {locations}<span class="cursor" aria-hidden="true"></span></p>
        <div class="actions">
          <a class="btn btn--primary" href={person.resumePdf}>résumé (pdf)</a>
          <a class="btn" href={person.github} target="_blank" rel="noopener noreferrer">github</a>
        </div>
        </div>
      </div>
    </section>

    <Section id="projects" label="projects">
      <Carousel label="projects">
        {projects.map((p) => <li><ProjectCard project={p} /></li>)}
      </Carousel>
    </Section>

    <Section id="experience" label="experience">
      <Carousel label="roles">
        {roles.map((r) => <li><ExperienceCard role={r} /></li>)}
      </Carousel>
    </Section>

    <Section id="education" label="education & skills">
      <div class="edu">
        <h3>{education.school}</h3>
        <p class="mono muted">{education.degree} · {education.minor}</p>
        <p class="mono muted">GPA {education.gpa} · expected {education.expected} · {education.location}</p>
        <h4 class="sub-label">coursework</h4>
        {education.coursework.map((group) => (
          <div class="course-group">
            <p class="group-name">{group.name}</p>
            <Tags items={group.courses} />
          </div>
        ))}
        <h4 class="sub-label">technical</h4>
        {technical.map((group) => (
          <div class="course-group">
            <p class="group-name">{group.name}</p>
            <Tags items={group.skills} />
          </div>
        ))}
      </div>
    </Section>

    <Section id="activities" label="off the keyboard">
      <ul class="activities">
        {activities.map((a) => (
          <li>
            <span class="tile" aria-hidden="true">
              {a.logo ? <img src={a.logo} alt="" width="40" height="40" /> : <span class="mark">{a.mark}</span>}
            </span>
            <div>
              <h3>{a.name}</h3>
              {a.role && <p class="activity-role">{a.role}</p>}
            </div>
          </li>
        ))}
      </ul>
      <div class="interests">
        <p class="label">interests</p>
        <ul class="tags">
          {interests.map((i) => (
            <li>
              {i.href ? (
                <a
                  class="tag tag--accent tag--link"
                  href={i.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={i.description ? `${i.label} — ${i.description}` : i.label}
                >{i.label}</a>
              ) : (
                <span class="tag tag--accent">{i.label}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
    </Section>

  </main>
</Base>

<style>
  .hero {
    padding: var(--space-6) 0 var(--space-5);
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
    background-size: 24px 24px;
    border-bottom: 1px solid var(--border);
  }
  .hero-inner { display: flex; align-items: center; gap: var(--space-4); }
  .hero-text { min-width: 0; }
  .portrait {
    flex-shrink: 0;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--border);
  }
  .meta { margin: var(--space-2) 0 var(--space-3); color: var(--fg-muted); }
  .cursor { display: inline-block; width: 0.55em; height: 1em; margin-left: 4px; vertical-align: -0.15em; background: var(--accent); animation: blink 1.1s steps(2, start) infinite; }
  @keyframes blink { to { visibility: hidden; } }
  @media (prefers-reduced-motion: reduce) { .cursor { animation: none; } }
  .actions { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  .muted { color: var(--fg-muted); margin: 0 0 6px; }
  .edu h3 { margin-bottom: 6px; }
  /* `coursework` / `technical` lead their sectors: larger, brighter, and ruled off,
     so the parent reads before the sector names underneath it. */
  .sub-label {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--fg);
    margin: var(--space-4) 0 var(--space-3);
    padding-bottom: var(--space-1);
    border-bottom: 1px solid var(--border);
  }
  /* Coursework is grouped by sector; the sector name is the accent line above its chips. */
  .course-group + .course-group { margin-top: var(--space-2); }
  .group-name {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: color-mix(in srgb, var(--accent) 72%, var(--fg-muted));
    margin: 0 0 6px;
    max-width: none;
  }
  /* Square logo, then name and title only — no dates column, no bullets. */
  .activities { list-style: none; padding: 0; margin: 0; max-width: none; }
  .activities li {
    margin: 0;
    padding: var(--space-2) 0;
    border-top: 1px solid var(--border);
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .activities li:last-child { border-bottom: 1px solid var(--border); }
  .activities h3 { font-size: 1.1rem; }
  .activity-role { font-family: var(--font-mono); font-size: 0.8rem; color: var(--fg-muted); margin: 4px 0 0; }
  /* Same tile as the experience cards, so the two sections read as one system. */
  .activities .tile {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    overflow: hidden;
  }
  .activities .tile:has(img) { border-color: transparent; }
  .activities .tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .activities .mark {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent);
  }
  /* A bar across the bottom: the `// interests` label, then every interest
     as a chip outlined in the accent, all on one flowing line. */
  .interests {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-3);
  }
  .interests .label { margin: 0; white-space: nowrap; }
  .interests .tag--accent { border-color: var(--accent); color: var(--fg); }
  /* A linked interest lights up so the chip reads as a link rather than a label. */
  .interests .tag--link {
    transition:
      background var(--dur) ease,
      box-shadow var(--dur) ease,
      color var(--dur) ease;
  }
  .interests .tag--link:hover,
  .interests .tag--link:focus-visible {
    background: color-mix(in srgb, var(--accent) 18%, transparent);
    color: var(--fg);
    text-decoration: none;
    box-shadow:
      0 0 0 1px var(--accent),
      0 0 18px -4px color-mix(in srgb, var(--accent) 55%, transparent);
  }
  @media (max-width: 767px) {
    .hero { padding: var(--space-5) 0 var(--space-4); }
    .hero-inner { gap: var(--space-3); }
    .portrait { width: 92px; height: 92px; }
  }
  @media (max-width: 480px) {
    .hero-inner { flex-direction: column; align-items: flex-start; gap: var(--space-2); }
  }
</style>
