---
import '@fontsource-variable/libre-franklin';
import '@fontsource/sometype-mono/400.css';
import '@fontsource/sometype-mono/500.css';
import '@fontsource/sometype-mono/600.css';
import '../styles/tokens.css';
import '../styles/workpaper.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#e9ede2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171b14" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Restore the reader's chosen sheet before first paint.
      try {
        const t = localStorage.getItem('sheet');
        if (t === 'light' || t === 'dark') {
          document.documentElement.setAttribute('data-theme', t);
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <!--
      THESIS: Not a portfolio of projects but the working papers behind them —
      every figure carries the pencil tick that resolves to the source it was
      agreed to. Refuses the three-up project-card grid the category ships.
      OWN-WORLD: Columnar analysis stock — pale green sheet, green-bar banded
      rows, printed hairline ruling, red and blue wax pencil, Libre Franklin
      with Sometype Mono on every figure. Recognizable with all content removed
      by its banded schedules and margin index.
      STORY: A hiring engineer learns he builds AI systems and the measurement
      that decides whether they worked, believes it because every number
      resolves to a public repository, and opens a sheet or takes the resume.
      FIRST VIEWPORT: A bounded ruled sheet on bare stock — a working paper is
      a physical object with edges, so it sits on the desk rather than bleeding
      off it. Name set large at top-left, scope one line beneath, index A-1 on
      its folder tab and the tick legend in the right margin; immediately below,
      Schedule A's ruled rows, each project's measured figure in the money
      column with its tick.
      FORM: The Audit Workpaper — candidate 6 of the ordered grounded list;
      seed key 24b15556.
      FINISH: unreviewed and undocumented is unfinished; this build ends with
      the finish review, the verdict, DESIGN.md, and every shipping raster
      carrying its provenance.
    -->
    <a class="skip" href="#main">Skip to content</a>
    <slot />

    <script is:inline>
      // The tick legend's draw-on is pure CSS; no script participates in it, so
      // it has no failure mode. The only behaviour here is the sheet toggle.

      // Sheet toggle: daylight or desk lamp.
      document.addEventListener('click', function (ev) {
        var btn = ev.target instanceof Element ? ev.target.closest('[data-sheet-toggle]') : null;
        if (!btn) return;
        var root = document.documentElement;
        var current =
          root.getAttribute('data-theme') ||
          (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        var next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('sheet', next); } catch (e) {}
        btn.setAttribute('aria-pressed', String(next === 'dark'));
      });
    </script>

    <style is:global>
      .skip {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--stock-raised);
        color: var(--ink);
        padding: var(--s-3) var(--s-4);
        border: 1px solid var(--rule-strong);
        z-index: 10;
      }
      .skip:focus { left: var(--s-4); top: var(--s-4); }
    </style>
  </body>
</html>
