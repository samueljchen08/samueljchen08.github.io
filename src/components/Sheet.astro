---
/**
 * The working paper itself: a bounded sheet with its index in the top-right
 * corner, exactly where an auditor writes it. The index is the address of the
 * sheet, and cross-references elsewhere on the site point at it.
 */
interface Props {
  index: string;
  /** Short caption for the sheet, printed beside the index. */
  caption: string;
}

const { index, caption } = Astro.props;
---

<div class="sheet">
  <div class="sheet-body">
    <div class="sheet-rail">
      <span class="label sheet-caption">{caption}</span>
      <div class="sheet-rail-end">
        <button
          type="button"
          class="sheet-toggle"
          data-sheet-toggle
          aria-pressed="false"
          aria-label="Desk lamp — switch this sheet to the dark theme"
        >
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none" stroke="currentColor"
               stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <circle cx="7" cy="7" r="3" />
            <path d="M7 .8v1.6M7 11.6v1.6M1.6 7H.2M13.8 7h-1.4M3.2 3.2 2.2 2.2M11.8 11.8l-1-1M10.8 3.2l1-1M2.2 11.8l1-1" />
          </svg>
          <span>Sheet</span>
        </button>
        <span class="index index--tab sheet-index">{index}</span>
      </div>
    </div>
    <hr class="rule-heavy" />
    <slot />
  </div>
</div>

<style>
  .sheet-rail {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-2) var(--s-5);
    background: var(--stock-band);
  }

  .sheet-caption {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .sheet-rail-end {
    display: flex;
    align-items: flex-end;
    gap: var(--s-4);
    flex: none;
  }

  .sheet-toggle {
    display: inline-flex;
    align-items: center;
    padding-bottom: var(--s-1);
    gap: var(--s-2);
    background: none;
    border: 0;
    padding: var(--s-1) 0;
    cursor: pointer;
    color: var(--ink-faint);
    font-family: var(--f-data);
    font-size: var(--t-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: color 0.18s var(--ease);
  }
  .sheet-toggle:hover { color: var(--ink); }

  .sheet-index {
    font-size: var(--t-base);
    letter-spacing: 0.08em;
  }

  @media (max-width: 720px) {
    .sheet-rail { padding-inline: var(--s-4); }
    .sheet-toggle span { display: none; }
  }
</style>
