---
/**
 * A cross-reference in blue pencil. Every link between sheets is one of these,
 * so the index is the navigation rather than decoration on top of it.
 * The caret is drawn, not a unicode arrow.
 */
interface Props {
  to: string;
  index: string;
  label?: string;
  back?: boolean;
}

const { to, index, label, back = false } = Astro.props;
---

<a class:list={['xref', back && 'xref--back']} href={to}>
  {back && (
    <svg class="xref-caret" width="9" height="9" viewBox="0 0 9 9" fill="none"
         stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true">
      <path d="M5.6 1.4 2.2 4.5l3.4 3.1" />
    </svg>
  )}
  <span class="xref-index">{index}</span>
  {label && <span class="xref-label">{label}</span>}
  {!back && (
    <svg class="xref-caret" width="9" height="9" viewBox="0 0 9 9" fill="none"
         stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
         stroke-linejoin="round" aria-hidden="true">
      <path d="M3.4 1.4 6.8 4.5 3.4 7.6" />
    </svg>
  )}
</a>

<style>
  .xref { display: inline-flex; align-items: baseline; gap: 0.45em; }
  .xref-index { flex: none; }
  .xref-label {
    color: var(--ink-muted);
    font-weight: 400;
    letter-spacing: 0.01em;
  }
  .xref-caret { align-self: center; }
  .xref-caret { flex: none; transition: transform 0.18s var(--ease); }
  .xref:hover .xref-caret { transform: translateX(2px); }
  .xref--back:hover .xref-caret { transform: translateX(-2px); }
</style>
