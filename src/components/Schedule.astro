---
/**
 * A ruled schedule on the pad. The heading carries the schedule's own name and
 * its count — both real information, which is why the schedule label is the
 * heading rather than a label sitting above one.
 */
interface Props {
  title: string;
  /** Right-hand annotation on the schedule head, e.g. "3 sheets". */
  tally?: string;
  id?: string;
  level?: 2 | 3;
}

const { title, tally, id, level = 2 } = Astro.props;
const Heading = `h${level}` as 'h2' | 'h3';
---

<section class="schedule" id={id}>
  <div class="schedule-head">
    <Heading class="schedule-title">{title}</Heading>
    {tally && <span class="label schedule-tally">{tally}</span>}
  </div>
  <slot />
</section>

<style>
  .schedule-tally { flex: none; }
</style>
