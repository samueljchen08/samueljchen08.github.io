---
/**
 * A circular carousel: the track rotates by one card per press and never reaches an
 * end — pressing next on the last card brings the first one round again.
 *
 * It rotates the DOM rather than tracking an index against cloned slides: next
 * animates the track one card to the left, then moves the leading card to the back
 * and resets the transform in the same frame. The result is seamless in both
 * directions with no duplicate nodes for a screen reader to read twice.
 */
interface Props {
  /** Plural noun for the arrow labels, e.g. "projects". */
  label: string;
}
const { label } = Astro.props;
---

<div class="carousel">
  <button type="button" class="arrow" data-dir="prev" aria-label={`Previous ${label}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M15 5 8 12l7 7" />
    </svg>
  </button>

  <div class="viewport">
    <ul class="track"><slot /></ul>
  </div>

  <button type="button" class="arrow" data-dir="next" aria-label={`Next ${label}`}>
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="m9 5 7 7-7 7" />
    </svg>
  </button>
</div>

<style>
  .carousel {
    /* The slide width reads this, and the script reads it back to know how many
       cards are on screen before deciding whether the arrows have anything to do. */
    --per-view: 2;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2);
  }

  .viewport { overflow: hidden; }

  .track {
    display: flex;
    align-items: stretch;
    gap: var(--space-3);
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: none;
    will-change: transform;
  }

  .arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    flex-shrink: 0;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--fg-muted);
    cursor: pointer;
    transition:
      border-color var(--dur) ease,
      color var(--dur) ease;
  }
  .arrow:hover {
    border-color: var(--accent);
    color: var(--fg);
  }
  /* Hidden by the script when every card already fits on screen. */
  .arrow[hidden] { display: none; }

  @media (max-width: 767px) {
    .carousel {
      --per-view: 1;
      gap: var(--space-1);
    }
    .arrow { width: 32px; height: 32px; }
  }
</style>

<style is:global>
  /* The slot's children are authored by the caller, so this rule cannot be scoped. */
  .carousel .track > * {
    flex: 0 0 calc((100% - (var(--per-view) - 1) * var(--space-3)) / var(--per-view));
    display: flex;
    margin: 0;
  }
</style>

<script>
  const DURATION = 320;
  const EASE = 'cubic-bezier(0.16, 1, 0.3, 1)';

  document.querySelectorAll<HTMLElement>('.carousel').forEach((root) => {
    const track = root.querySelector<HTMLElement>('.track');
    const arrows = root.querySelectorAll<HTMLButtonElement>('.arrow');
    if (!track) return;

    const perView = () =>
      parseInt(getComputedStyle(root).getPropertyValue('--per-view'), 10) || 1;

    // Nothing to rotate when the whole set is already visible.
    const sync = () => {
      const idle = track.children.length <= perView();
      arrows.forEach((a) => {
        a.hidden = idle;
      });
    };
    sync();
    window.addEventListener('resize', sync, { passive: true });

    let busy = false;

    /** Width of one card plus the gap to the next — the exact distance of one press. */
    const stride = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return 0;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first.getBoundingClientRect().width + gap;
    };

    /** Run `after` when the track's transition ends, or on a timer if it never fires. */
    const onSettled = (after: () => void) => {
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        track.removeEventListener('transitionend', finish);
        after();
      };
      track.addEventListener('transitionend', finish);
      setTimeout(finish, DURATION + 80);
    };

    const go = (dir: 'prev' | 'next') => {
      if (busy || track.children.length <= perView()) return;
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const distance = stride();
      busy = true;

      if (dir === 'next') {
        const land = () => {
          track.style.transition = 'none';
          track.append(track.firstElementChild!);
          track.style.transform = 'none';
          void track.offsetWidth; // commit the reset before anything animates again
          busy = false;
        };
        if (reduce) return land();
        track.style.transition = `transform ${DURATION}ms ${EASE}`;
        track.style.transform = `translate3d(${-distance}px, 0, 0)`;
        onSettled(land);
      } else {
        // Bring the last card to the front off-screen, then slide it into place.
        track.style.transition = 'none';
        track.prepend(track.lastElementChild!);
        track.style.transform = `translate3d(${-distance}px, 0, 0)`;
        void track.offsetWidth;
        if (reduce) {
          track.style.transform = 'none';
          busy = false;
          return;
        }
        track.style.transition = `transform ${DURATION}ms ${EASE}`;
        track.style.transform = 'none';
        onSettled(() => {
          busy = false;
        });
      }
    };

    arrows.forEach((arrow) => {
      arrow.addEventListener('click', () => go(arrow.dataset.dir === 'prev' ? 'prev' : 'next'));
    });
  });
</script>
